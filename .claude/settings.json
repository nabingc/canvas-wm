{
  "enabledMcpjsonServers": ["rea"],
  "permissions": {
    "allow": [
      "mcp__rea__*",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Bash(dotnet build:*)",
      "Bash(dotnet test:*)",
      "Bash(dotnet restore:*)",
      "Bash(dotnet format:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "ask": [
      "Bash(dotnet add:*)",
      "Bash(dotnet new:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)"
    ]
  }
}
